<UserControl x:Class="UvexAdv.Nina.Plugin.SepMainFocusView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:nina="clr-namespace:NINA.View;assembly=NINA"
 xmlns:local="clr-namespace:UvexAdv.Nina.Plugin"
 x:Name="Root" Foreground="#DDEAF4" Background="#101B28"
 local:ObservationStaticTextLocalization.IsEnabled="True">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisible"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDEAF4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#192B3B"/><Setter Property="Foreground" Value="#E2EDF5"/>
   <Setter Property="BorderBrush" Value="#52677C"/><Setter Property="Padding" Value="6,4"/>
   <Setter Property="MinHeight" Value="29"/>
   <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="#FF858C"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Field" TargetType="StackPanel"><Setter Property="Width" Value="180"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#21394B"/><Setter Property="Foreground" Value="#E2EDF5"/><Setter Property="BorderBrush" Value="#52758B"/>
   <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,4"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#81DDD5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFD58A"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Background" Value="#101B28"/><Setter Property="BorderBrush" Value="#3C586D"/><Setter Property="Foreground" Value="#DDEAF4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TabPanel IsItemsHost="True" Margin="0,0,0,4"/>
    <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter ContentSource="SelectedContent"/></Border>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Background" Value="#1A2C3D"/><Setter Property="Foreground" Value="#C7D8E5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border Padding="14,6" Margin="0,0,4,0" CornerRadius="3" Background="{TemplateBinding Background}"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176F73"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="主镜对焦" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="主控电调焦 + PHD2 导星相机 · SEP 星光集中度测量" Foreground="#AFC4D5" Margin="0,3,0,6"/>
  </StackPanel>
  <Border Grid.Row="1" Padding="8" Background="#162A3B" BorderBrush="#3C667F" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
   <StackPanel>
    <TextBlock x:Name="FocusAvailability" Text="{Binding AvailabilityMessage}" Foreground="#FFD58A" FontWeight="SemiBold"/>
    <TextBlock x:Name="FocusStatus" Text="{Binding Status}" Foreground="#A3E2DE" Margin="0,4,0,6"/>
    <WrapPanel>
     <Button x:Name="StartFocusButton" Content="开始主镜对焦" Command="{Binding StartCommand}" ToolTip="{Binding AvailabilityMessage}" ToolTipService.ShowOnDisabled="True">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
       <Setter Property="Background" Value="#147D70"/><Setter Property="Foreground" Value="White"/>
       <Style.Triggers><DataTrigger Binding="{Binding NativeToolbar, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
      </Style></Button.Style>
     </Button>
     <Button x:Name="CancelFocusButton" Content="取消对焦" Command="{Binding CancelCommand}" ToolTip="停止新采样；仅在安全且位置可信时返回原焦位。"/>
     <Button Content="保存设置" Command="{Binding SaveCommand}"/>
     <Button Content="打开记录目录" Command="{Binding OpenEvidenceCommand}"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
   <TabItem Header="设置">
    <ScrollViewer x:Name="FocusSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
     <StackPanel Margin="10" IsEnabled="{Binding CanEdit}" Validation.Error="OnValidationError">
      <TextBlock Text="1 · 允许移动的范围" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBlock Text="填写这台电调焦实际允许的最小、最大焦位。不是要求移动到这两个端点；采样只在当前焦位附近进行。" Foreground="#AFC4D5" Margin="0,0,0,8"/>
      <WrapPanel>
       <StackPanel Style="{StaticResource Field}"><TextBlock Text="最小焦位（步）"/><TextBox x:Name="FocusMinimum" Text="{Binding MinimumPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Style="{StaticResource Field}"><TextBlock Text="最大焦位（步）"/><TextBox x:Name="FocusMaximum" Text="{Binding MaximumPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="2 · 当前焦位附近如何采样" FontWeight="SemiBold" Margin="0,3,0,8"/>
      <WrapPanel>
       <StackPanel Style="{StaticResource Field}"><TextBlock Text="相邻焦位间隔（步）"/><TextBox Text="{Binding Step, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Style="{StaticResource Field}"><TextBlock Text="两侧各采样几处"/><TextBox Text="{Binding HalfPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Style="{StaticResource Field}"><TextBlock Text="每处拍摄张数"/><TextBox Text="{Binding Frames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Style="{StaticResource Field}"><TextBlock Text="单张曝光（秒）"/><TextBox Text="{Binding ExposureSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Style="{StaticResource Field}"><TextBlock Text="导星相机增益（%）"/><TextBox Text="{Binding GainPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding SamplingSummary}" Foreground="#8EDAD2" Margin="0,0,0,8"/>
      <Expander Header="高级：传感器与现场限制" Foreground="#DDEAF4">
       <WrapPanel Margin="0,8,0,0">
        <StackPanel Style="{StaticResource Field}"><TextBlock Text="原始帧饱和值（ADU）"/><TextBox Text="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
        <StackPanel Style="{StaticResource Field}"><TextBlock Text="最低目标高度（度）"/><TextBox Text="{Binding MinimumAltitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
       </WrapPanel>
      </Expander>
      <TextBlock Text="开始前：结束自动观测，保持屋顶和镜盖打开、目标已在安全高度；PHD2 停止导星。此按钮不会开顶、转向或停止其他操作。" Foreground="#AFC4D5" Margin="0,10,0,6"/>
      <TextBlock x:Name="FocusSettingsEndNote" Text="原生入口：在 N.I.N.A. 选项中将“自动对焦”实现选为 OpenAstroSpec SEP · 主镜 / PHD2，再使用主控台原生“自动对焦”窗口。不是“星点检测”下拉框。" Foreground="#AFC4D5"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="曲线" Content="{Binding}">
    <TabItem.ContentTemplate><DataTemplate>
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding CurveCaption}" Foreground="#AFC4D5" Margin="0,0,0,6"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <nina:AutoFocusChart x:Name="NativeFocusChart" MinHeight="380">
       <nina:AutoFocusChart.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDEAF4"/></Style></nina:AutoFocusChart.Resources>
      </nina:AutoFocusChart>
     </ScrollViewer>
    </Grid>
    </DataTemplate></TabItem.ContentTemplate>
   </TabItem>
   <TabItem Header="记录">
    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="R50 / R80：包住 50% / 80% 星光所需的半径，单位像素。比较同一批星，不要求星点变圆。候选没有重复优势就保留原焦位。" Foreground="#AFC4D5" Margin="0,0,0,8"/>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Curve}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
      <DataGrid.Columns>
       <DataGridTextColumn Header="焦位" Binding="{Binding Position, Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="R50 / px" Binding="{Binding R50, Mode=OneWay, StringFormat=F2}" Width="*"/>
       <DataGridTextColumn Header="R80 / px" Binding="{Binding R80, Mode=OneWay, StringFormat=F2}" Width="*"/>
       <DataGridTextColumn Header="有效帧" Binding="{Binding Frames, Mode=OneWay}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
