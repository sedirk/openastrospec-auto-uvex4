              <TextBlock Text="Preset SHA-256"/><TextBox Text="{Binding CommissioningPresetSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="Hardware fingerprint SHA-256"/><TextBox Text="{Binding CommissioningHardwareFingerprintSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="Night Setup 快照文件"/><TextBox Text="{Binding NightSetupSnapshotPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="Night Setup SHA-256"/><TextBox Text="{Binding NightSetupSnapshotSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="赤道仪 DeviceId"/><TextBox Text="{Binding ExpectedTelescopeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="ATR585M DeviceId"/><TextBox Text="{Binding ExpectedAtrCameraId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="PHD2 / G3 Profile"/><TextBox Text="{Binding ExpectedG3ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="PHD2 registry evidence SHA-256"/><TextBox Text="{Binding Phd2ProfileEvidenceSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="QHY service CameraId"/><TextBox Text="{Binding ExpectedQhyCameraId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <StackPanel Grid.Row="2" Margin="0,5,0,0">
        <Border Background="#0E2A1B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="7"
                Visibility="{Binding HasOperatorNotice, Converter={StaticResource ObservationBoolToVisibility}}">
          <TextBlock Text="{Binding OperatorNotice}" Foreground="#86EFAC" TextWrapping="Wrap" />
        </Border>
        <Border Background="#3F1515" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,4,0,0"
                Visibility="{Binding HasError, Converter={StaticResource ObservationBoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="错误 / 阻断" FontWeight="Bold" Foreground="#FCA5A5" />
            <TextBlock Text="{Binding Error}" Foreground="#FCA5A5" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="UvexAdv.Nina.Plugin.UvexCalibrationLibraryDockable_Dockable">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="ATR585M 校准库" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="曝光由 N.I.N.A. 执行；插件不会直接加载 ToupTek SDK，也不会打开导星相机。"
                       TextWrapping="Wrap" Opacity="0.8" Margin="0,3,0,7" />
            <TextBlock Text="{Binding CameraStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BoundCameraId, StringFormat=绑定 DeviceId：{0}}" TextWrapping="Wrap" Opacity="0.75" />
            <Button Content="绑定当前 ATR585M" Command="{Binding BindCurrentCameraCommand}" HorizontalAlignment="Left" Margin="0,7,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="兼容性键（不同参数绝不混库）" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gain}" Margin="5,2" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Offset" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Offset}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Binning" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Binning}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="目标温度 °C" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding TemperatureC}" Margin="5,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="温度容差 ±°C" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TemperatureToleranceC}" Margin="5,2" />
          </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="采集计划" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bias 曝光(s)" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BiasExposureSeconds}" Margin="5,2" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Bias 张数" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding BiasFrameCount}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Dark 曝光(s)" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DarkExposureSecondsCsv}" ToolTip="英文逗号分隔，例如 300,600" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="每档张数" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding DarkFrameCountEach}" Margin="5,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="启动丢弃帧" VerticalAlignment="Center" ToolTip="连接相机后的前几帧不入库，用于稳定 ToupTek 读出链路" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WarmupFrameCount}" Margin="5,2" />
            <CheckBox Grid.Row="4" Grid.ColumnSpan="5" Content="样本达到 5 张且质量门通过时生成剔除一高一低像素的 master（Master Dark 保留 bias）"
                      IsChecked="{Binding BuildMasters}" Margin="0,6,0,0" />
          </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="库目录" FontWeight="SemiBold" />
            <TextBox Text="{Binding LibraryRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
            <WrapPanel>
              <Button Content="打开目录" Command="{Binding OpenLibraryCommand}" Margin="0,0,6,0" />
              <Button Content="重新扫描" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding InventoryStatus}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#33220B" BorderBrush="#D97706" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="ATR585M 没有机械快门。开始前必须人工确认暗环境；此确认不会写入 Profile。" TextWrapping="Wrap" />
            <CheckBox Content="我确认：镜头盖已盖好，屋顶已关闭，设备内没有漏光"
                      IsChecked="{Binding DarknessConfirmed}" FontWeight="SemiBold" Margin="0,8" />
            <WrapPanel>
              <Button Content="开始建立/补充校准库" Command="{Binding StartCommand}" Padding="12,5" Margin="0,0,8,0" />
              <Button Content="完成当前操作后取消" Command="{Binding CancelCommand}" Padding="12,5" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="5">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="15" />
          <TextBlock Text="{Binding RunStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock Text="{Binding LastSavedPath}" TextWrapping="Wrap" Opacity="0.75" />
          <TextBlock Text="{Binding Error}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate DataType="{x:Type seq:WaitUvexReadyItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="超时(s)"/><TextBox Width="70" Text="{Binding TimeoutSeconds}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:GotoWavelengthItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="波长(nm)"/><TextBox Width="80" Text="{Binding WavelengthNm}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:SelectSlitItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="狭缝"/><TextBox Width="50" Text="{Binding Position}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:MoveFocusItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="相对步数"/><TextBox Width="80" Text="{Binding DeltaSteps}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:MaintenanceModeItem}"><CheckBox Content="进入维护模式（取消为退出）" IsChecked="{Binding EnterMaintenance}"/></DataTemplate>

  <HierarchicalDataTemplate DataType="{x:Type seq:UvexTargetObservationContainer}" ItemsSource="{Binding Items}">
    <ninaSeq:HierarchicalSequenceContainerView>
      <ninaSeq:HierarchicalSequenceContainerView.SequenceContainerContent>
        <StackPanel Margin="5">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <Border CornerRadius="3" Padding="8,3" Margin="0,0,10,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#1B5E20" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UseRealMode}" Value="True">
                      <Setter Property="Background" Value="#B71C1C" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding ExecutionModeLabel}" Foreground="White" FontWeight="Bold" />
            </Border>
            <CheckBox Content="此序列请求 REAL 模式" IsChecked="{Binding UseRealMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding ExecutionModeWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5" />
          <TextBlock Text="无人值守自动推进；失败自动暂停，支持恢复、取消与人工接管。" TextWrapping="Wrap" FontStyle="Italic" />
          <WrapPanel Margin="0,5,0,0">
            <TextBlock Text="目标" VerticalAlignment="Center"/><TextBox Width="125" Text="{Binding TargetName}" Margin="4,0,9,0"/>
            <TextBlock Text="RA°" VerticalAlignment="Center"/><TextBox Width="75" Text="{Binding RightAscensionDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="Dec°" VerticalAlignment="Center"/><TextBox Width="75" Text="{Binding DeclinationDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="分钟" VerticalAlignment="Center"/><TextBox Width="60" Text="{Binding DurationMinutes}" Margin="4,0"/>
          </WrapPanel>
          <WrapPanel Margin="0,4,0,0">
            <TextBlock Text="围墙" VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding HorizonMinimumDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="启动裕量" VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding HorizonStartMarginDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="继续裕量" VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding HorizonContinueMarginDegrees}" Margin="4,0"/>
          </WrapPanel>
        </StackPanel>
      </ninaSeq:HierarchicalSequenceContainerView.SequenceContainerContent>
    </ninaSeq:HierarchicalSequenceContainerView>
  </HierarchicalDataTemplate>

  <DataTemplate DataType="{x:Type seq:ObservationStageMarkerItem}">
    <ninaSeq:SequenceBlockView>
      <ninaSeq:SequenceBlockView.SequenceItemContent>
        <TextBlock Text="{Binding DisplayName}" FontStyle="Italic" Opacity="0.8" />
      </ninaSeq:SequenceBlockView.SequenceItemContent>
    </ninaSeq:SequenceBlockView>
  </DataTemplate>
</ResourceDictionary>
