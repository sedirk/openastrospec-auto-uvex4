                </StackPanel>
              </Border>
              <Border Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="广域→狭缝场转换" FontWeight="Bold" Foreground="#7DD3FC" />
                  <TextBlock Text="{Binding WideToSlitTransferModeText, StringFormat=WideToSlitTransferMode：{0}}" FontFamily="Consolas" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding WideToSlitTransferStatus}" TextWrapping="Wrap" Foreground="#BAE6FD" Margin="0,3,0,0" />
                  <Separator Margin="0,7,0,6" />
                  <CheckBox Content="G3 一旦解算成功，立即建立 QHY/G3 快速双解算候选"
