                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Policy ID" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="4" Text="{Binding QhyG3FastPairPolicyId, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="单张 QHY 曝光 (s)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QhyG3FastPairExposureSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="缓存最长年龄 (s)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="4" Text="{Binding QhyG3FastPairMaximumCachedAgeSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="两帧中点差 (s)" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding QhyG3FastPairMaximumMidpointSeparationSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="整组时限 (s)" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="4" Text="{Binding QhyG3FastPairMaximumWallClockSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Mount span (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding QhyG3FastPairMaximumMountSpanArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="候选有效期 (h)" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="4" Text="{Binding QhyG3FastPairCandidateValidityHours, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="不确定度上限 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding QhyG3FastPairMaximumCandidateUncertaintyArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Text="单样本永远是 Candidate；需独立聚合/验证后才能激活。" TextWrapping="Wrap" Foreground="#FDE68A" Margin="5,2"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="确定性鬼影辅助（受设备标定约束）" FontWeight="Bold" Foreground="#7DD3FC" />
                  <TextBlock Text="只在普通/超亮目标身份定位失败时，使用同一无运动 OFF/ON/OFF 序列中至少两张新鲜、同曝光 OFF 帧。标定、完整策略、提取策略、安装/方向指纹均由 schema 4 preset 及其 SHA-256 绑定；不含目标常量或两镜固定光轴差。"
                             Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,3,0,6" />
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="GhostAssistanceMode" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="230"
                              ItemsSource="{Binding GhostAssistanceModes}"
                              SelectedItem="{Binding GhostAssistanceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="鬼影辅助模式" />
                  </WrapPanel>
                  <TextBlock Text="Skip（默认）：不运行模板；AutoIfValidElseSkip：模板无效时继续既有长曝光 WCS/N.I.N.A. 居中/小步重解；RequireValid：模板无效时暂停等待处理。"
                             Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding GhostCalibrationSummaryText}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding GhostApplicabilityText}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding GhostDecisionText}" Foreground="#FDBA74" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <TextBlock Text="旧版 QHY 广域运动门（仅保留兼容/取证，不是当前生产路线）" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="当前前端只接受 QHY 正式 WCS 作为广域见证，不依据它移动赤道仪；大步运动交给 fresh G3 WCS + N.I.N.A.。以下 schema 1 参数只供旧运行记录重放和工程诊断，不再作为当前路线的启动阻断项。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,5" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="schema" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding QhyCoarseCenteringSchemaVersion, Mode=OneWay}" IsReadOnly="True" Margin="5,2"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="单次上限 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="4" Text="{Binding QhyCoarseMaximumSingleCorrectionArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="累计含回程 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QhyCoarseMaximumCumulativeCorrectionArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="总动作次数" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="4" Text="{Binding QhyCoarseMaximumCorrectionAttempts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="最长粗居中 (min)" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding QhyCoarseMaximumCenteringMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
              </Grid>
              <Border Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="G3 长曝光解算与 WCS 居中" FontWeight="Bold" Foreground="#7DD3FC" />
                  <TextBlock Text="曝光档位是带版本的设备参数；每档都由 PHD2 独占 G3 拍一张新全帧。PlateSolve3 正式成功解在像元尺度合理、数值有限且位于独立的两镜光轴可达范围内时直接信任；源数和匹配数只作遥测，不再另设项目硬门。两镜光轴范围不是后续小范围运动上限。若目标在画外，插件按该新 WCS 经 N.I.N.A. 做有界分段居中，再用新实报位置和新 G3 解验证实际天球响应。" TextWrapping="Wrap" Foreground="#BAE6FD" Margin="0,3,0,6" />
                  <TextBlock Text="判据分离：2″只约束静态 frame/mount 绑定和小步搜索稳定性；大步实报终点在完整运动预算内即可拍验证帧，光学到位必须由移动后的 fresh G3 WCS 证明。" TextWrapping="Wrap" Foreground="#FDE68A" Margin="0,0,0,6" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="曝光 preset schema" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding G3PlateSolveExposurePresetSchemaVersion, Mode=OneWay}" IsReadOnly="True" Margin="5,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="曝光 preset ID" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="4" Text="{Binding G3PlateSolveExposurePresetId, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="解算曝光档位 (ms)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding G3PlateSolveExposureMillisecondsCsv, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WCS 门 schema" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding G3WcsCenteringSchemaVersion, Mode=OneWay}" IsReadOnly="True" Margin="5,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="目标画内边距 (px)" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="4" Text="{Binding G3TargetInsideFieldMarginPixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="单次上限 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding G3WcsMaximumSingleCorrectionArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="最大半径 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="4" Text="{Binding G3WcsMaximumRadiusArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="累计含回程 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding G3WcsMaximumCumulativeMotionArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <StackPanel Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                      <TextBlock Text="动作" VerticalAlignment="Center"/><TextBox Width="45" Text="{Binding G3WcsMaximumCorrectionAttempts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Text="分钟" VerticalAlignment="Center"/><TextBox Width="45" Text="{Binding G3WcsMaximumCenteringMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="单动作最坏时长 (s)" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding G3MotionWorstCaseActionSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="移动后稳定等待 (s)" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="4" Text="{Binding G3MotionPostSlewSettleSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="两镜解算可达范围 (deg)" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding G3MaximumPlateSolveHintOffsetDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    <TextBlock Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2" Text="默认 5°；只检验解是否物理可达，不授权同等幅度运动" Foreground="#94A3B8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Text="大步后允许拍 fresh 验证帧的最大实报终点残差 (arcsec)" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="7" Grid.Column="4" Text="{Binding G3WcsFreshSolveAuthorizationResidualArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="G3 直接解算失败后的有界方形螺旋搜索" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="这些数值由所选台站配置方案加载，且不得超过设备标定的运动上限；0 表示未调试并会阻断真实模式。每步均重新检查暂停、安全、屋顶、天气、地平线和赤道仪状态，失败时按小步安全返回搜索原点。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,5" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="步长 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding G3SearchStepArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="最大半径 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="4" Text="{Binding G3SearchMaximumRadiusArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="累计运动 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding G3SearchMaximumCumulativeArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="搜索尝试次数" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="4" Text="{Binding G3SearchMaximumAttempts, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="最长搜索 (min)" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding G3SearchMaximumMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="模式" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="4" Text="SquareSpiral" IsReadOnly="True" Margin="5,2"/>
              </Grid>
              <TextBlock Text="PHD2 名称分域（必须精确匹配，不做模糊匹配）" FontWeight="Bold" Margin="0,0,0,4" />
              <TextBlock Text="注册表相机名"/><TextBox Text="{Binding Phd2RegistryCameraName, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,4" />
              <TextBlock Text="注册表赤道仪名"/><TextBox Text="{Binding Phd2RegistryMountName, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,4" />
              <TextBlock Text="JSON-RPC 运行时相机名"/><TextBox Text="{Binding Phd2RuntimeCameraName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="JSON-RPC 运行时赤道仪名"/><TextBox Text="{Binding Phd2RuntimeMountName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <Border Background="#2B1B12" BorderBrush="#FB923C" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,2,0,7">
                <StackPanel>
                  <CheckBox Content="本轮显式允许 DegradedSupervised 短时有监督科学块" IsChecked="{Binding AllowDegradedSupervisedScience}" />
                  <TextBlock Text="默认关闭。只有当前锁定动作配置勾选后，有监督降级模式才可继续；它仍不获得无人值守权限，所有后续证据/帧必须标注降级。设备标定方案不能替你勾选。" Foreground="#FDBA74" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="G3 曝光 (ms)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding G3ExposureMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Column="3" Text="G3 增益 (%)" VerticalAlignment="Center"/><TextBox Grid.Column="4" Text="{Binding G3GainPercent, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="G3 驱动恢复 (ms)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding G3CameraRecoveryDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="连续全幅之间；本机实测 3000 ms" Foreground="#94A3B8" VerticalAlignment="Center" Margin="5,2"/>
              </Grid>
              <Expander Header="超亮目标：饱和核的未饱和翼部入缝（例外分支，默认关闭）" IsExpanded="False" Margin="0,0,0,8">
                <Border Background="#2B1B12" BorderBrush="#FB923C" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                  <StackPanel>
                    <TextBlock Text="只适用于目标身份已由本轮新鲜 QHY WCS + 目录坐标锁定、并且 C11/Star Focuser Pro 有独立有效焦点证据的超亮目标。短曝光 G3 帧即使能用翼部求质心，也永远不能参与对焦；G3 解算失败本身不会放宽身份、唯一性或运动门。" Foreground="#FED7AA" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <CheckBox Content="显式启用超亮目标翼部质心分支" IsChecked="{Binding BrightTargetWingCentroidEnabled}" Margin="0,0,0,6" />
                    <TextBlock Text="启用前必须填写最短曝光、证据新鲜度和 QHY 残差；0 表示未配置并阻断。这里没有目标名、目标坐标、两镜光轴偏移或固定 500 ms。" Foreground="#FDBA74" TextWrapping="Wrap" Margin="0,0,0,5" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="最短 G3 曝光 (ms)" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BrightTargetMinimumG3ExposureMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="0" Grid.Column="3" Text="QHY WCS 最长年龄 (min)" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="4" Text="{Binding BrightTargetMaximumQhyWcsAgeMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="G3 帧最长年龄 (min)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BrightTargetMaximumG3FrameAgeMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="1" Grid.Column="3" Text="QHY 目标残差上限 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="4" Text="{Binding BrightTargetMaximumQhyResidualArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="目录坐标差上限 (arcsec)" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BrightTargetMaximumCatalogMismatchArcseconds, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="2" Grid.Column="3" Text="C11 焦点置信度下限" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="4" Text="{Binding BrightTargetMinimumC11FocusConfidence, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="3" Grid.Column="0" Text="饱和核最少像素" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BrightTargetMinimumSaturatedCorePixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="3" Grid.Column="3" Text="饱和核最多像素" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="4" Text="{Binding BrightTargetMaximumSaturatedCorePixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="4" Grid.Column="0" Text="翼部半径 (px)" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BrightTargetWingRadiusPixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="4" Grid.Column="3" Text="翼部最少像素" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="4" Text="{Binding BrightTargetMinimumWingPixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="5" Grid.Column="0" Text="翼部显著性下限 (sigma)" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding BrightTargetMinimumWingProminenceSigma, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="5" Grid.Column="3" Text="翼部 ADU 上限/饱和" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="4" Text="{Binding BrightTargetMaximumWingLevelFraction, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="6" Grid.Column="0" Text="翼部 SNR 下限" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding BrightTargetMinimumWingSignalToNoise, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="6" Grid.Column="3" Text="角向覆盖下限" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="4" Text="{Binding BrightTargetMinimumAngularCoverageFraction, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="7" Grid.Column="0" Text="对向翼部平衡下限" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding BrightTargetMinimumOpposedWingBalance, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="7" Grid.Column="3" Text="内外质心差上限 (px)" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="4" Text="{Binding BrightTargetMaximumWingCentroidDisagreementPixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="8" Grid.Column="0" Text="边缘安全距离 (px)" VerticalAlignment="Center"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding BrightTargetEdgeMarginPixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="8" Grid.Column="3" Text="饱和邻星排除半径 (px)" VerticalAlignment="Center"/><TextBox Grid.Row="8" Grid.Column="4" Text="{Binding BrightTargetNearbySaturatedCoreRadiusPixels, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="9" Grid.Column="0" Text="唯一性比值下限" VerticalAlignment="Center"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding BrightTargetMinimumUniquenessRatio, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                      <TextBlock Grid.Row="9" Grid.Column="3" Text="次峰/鬼影比例上限" VerticalAlignment="Center"/><TextBox Grid.Row="9" Grid.Column="4" Text="{Binding BrightTargetMaximumSecondaryPeakRatio, UpdateSourceTrigger=PropertyChanged}" Margin="5,2"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </Expander>
              <CheckBox Content="标定包静态校验已通过（最新完整包默认自动确认；不会绕过运行时硬门）" IsChecked="{Binding RealModeCommissioned}" Margin="0,0,0,6" />
              <TextBlock Text="设备标定文件"/><TextBox Text="{Binding CommissioningPresetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="设备标定方案 ID"/><TextBox Text="{Binding CommissioningPresetId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="设备标定方案 SHA-256"/><TextBox Text="{Binding CommissioningPresetSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="硬件指纹 SHA-256"/><TextBox Text="{Binding CommissioningHardwareFingerprintSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="本夜光学设置快照文件"/><TextBox Text="{Binding NightSetupSnapshotPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="本夜光学设置 SHA-256"/><TextBox Text="{Binding NightSetupSnapshotSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="赤道仪 DeviceId"/><TextBox Text="{Binding ExpectedTelescopeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="ATR585M DeviceId"/><TextBox Text="{Binding ExpectedAtrCameraId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="PHD2 / G3 Profile"/><TextBox Text="{Binding ExpectedG3ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="PHD2 registry evidence SHA-256"/><TextBox Text="{Binding Phd2ProfileEvidenceSha256, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
              <TextBlock Text="QHY service CameraId"/><TextBox Text="{Binding ExpectedQhyCameraId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <StackPanel Grid.Row="2" Margin="0,5,0,0">
        <Border Background="#0E2A1B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="7"
                Visibility="{Binding HasOperatorNotice, Converter={StaticResource ObservationBoolToVisibility}}">
          <TextBlock Text="{Binding OperatorNotice}" Foreground="#86EFAC" TextWrapping="Wrap" />
        </Border>
        <Border Background="#3F1515" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,4,0,0"
                Visibility="{Binding HasError, Converter={StaticResource ObservationBoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="错误 / 阻断" FontWeight="Bold" Foreground="#FCA5A5" />
            <TextBlock Text="{Binding Error}" Foreground="#FCA5A5" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="UvexAdv.Nina.Plugin.UvexCalibrationLibraryDockable_Dockable">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="ATR585M 校准库" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="曝光由 N.I.N.A. 执行；插件不会直接加载 ToupTek SDK，也不会打开导星相机。"
                       TextWrapping="Wrap" Opacity="0.8" Margin="0,3,0,7" />
            <TextBlock Text="{Binding CameraStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BoundCameraId, StringFormat=绑定 DeviceId：{0}}" TextWrapping="Wrap" Opacity="0.75" />
            <Button Content="绑定当前 ATR585M" Command="{Binding BindCurrentCameraCommand}" HorizontalAlignment="Left" Margin="0,7,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="兼容性键（不同参数绝不混库）" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gain" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gain}" Margin="5,2" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Offset" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Offset}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Binning" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Binning}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="目标温度 °C" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding TemperatureC}" Margin="5,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="温度容差 ±°C" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TemperatureToleranceC}" Margin="5,2" />
          </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="采集计划" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bias 曝光(s)" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BiasExposureSeconds}" Margin="5,2" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Bias 张数" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding BiasFrameCount}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Dark 曝光(s)" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DarkExposureSecondsCsv}" ToolTip="英文逗号分隔，例如 300,600" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="每档张数" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding DarkFrameCountEach}" Margin="5,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="启动丢弃帧" VerticalAlignment="Center" ToolTip="连接相机后的前几帧不入库，用于稳定 ToupTek 读出链路" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WarmupFrameCount}" Margin="5,2" />
            <CheckBox Grid.Row="4" Grid.ColumnSpan="5" Content="样本达到 5 张且质量门通过时生成剔除一高一低像素的 master（Master Dark 保留 bias）"
                      IsChecked="{Binding BuildMasters}" Margin="0,6,0,0" />
          </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="库目录" FontWeight="SemiBold" />
            <TextBox Text="{Binding LibraryRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,5" />
            <WrapPanel>
              <Button Content="打开目录" Command="{Binding OpenLibraryCommand}" Margin="0,0,6,0" />
              <Button Content="重新扫描" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding InventoryStatus}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#33220B" BorderBrush="#D97706" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="ATR585M 没有机械快门。开始前必须人工确认暗环境；此确认不会写入 Profile。" TextWrapping="Wrap" />
            <CheckBox Content="我确认：镜头盖已盖好，屋顶已关闭，设备内没有漏光"
                      IsChecked="{Binding DarknessConfirmed}" FontWeight="SemiBold" Margin="0,8" />
            <WrapPanel>
              <Button Content="开始建立/补充校准库" Command="{Binding StartCommand}" Padding="12,5" Margin="0,0,8,0" />
              <Button Content="完成当前操作后取消" Command="{Binding CancelCommand}" Padding="12,5" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="5">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="15" />
          <TextBlock Text="{Binding RunStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock Text="{Binding LastSavedPath}" TextWrapping="Wrap" Opacity="0.75" />
          <TextBlock Text="{Binding Error}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate DataType="{x:Type seq:WaitUvexReadyItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="超时(s)"/><TextBox Width="70" Text="{Binding TimeoutSeconds}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:GotoWavelengthItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="波长(nm)"/><TextBox Width="80" Text="{Binding WavelengthNm}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:SelectSlitItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="狭缝"/><TextBox Width="50" Text="{Binding Position}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:MoveFocusItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="相对步数"/><TextBox Width="80" Text="{Binding DeltaSteps}"/></StackPanel></DataTemplate>
  <DataTemplate DataType="{x:Type seq:MaintenanceModeItem}"><CheckBox Content="进入维护模式（取消为退出）" IsChecked="{Binding EnterMaintenance}"/></DataTemplate>

  <HierarchicalDataTemplate DataType="{x:Type seq:UvexTargetObservationContainer}" ItemsSource="{Binding Items}">
    <ninaSeq:HierarchicalSequenceContainerView>
      <ninaSeq:HierarchicalSequenceContainerView.SequenceContainerContent>
        <StackPanel Margin="5">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <Border CornerRadius="3" Padding="8,3" Margin="0,0,10,0">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#1B5E20" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UseRealMode}" Value="True">
                      <Setter Property="Background" Value="#B71C1C" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding ExecutionModeLabel}" Foreground="White" FontWeight="Bold" />
            </Border>
            <CheckBox Content="此序列请求 REAL 模式" IsChecked="{Binding UseRealMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding ExecutionModeWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5" />
          <TextBlock Text="无人值守自动推进；失败自动暂停，支持恢复、取消与人工接管。" TextWrapping="Wrap" FontStyle="Italic" />
          <WrapPanel Margin="0,5,0,0">
            <TextBlock Text="目标" VerticalAlignment="Center"/><TextBox Width="125" Text="{Binding TargetName}" Margin="4,0,9,0"/>
            <TextBlock Text="RA°" VerticalAlignment="Center"/><TextBox Width="75" Text="{Binding RightAscensionDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="Dec°" VerticalAlignment="Center"/><TextBox Width="75" Text="{Binding DeclinationDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="分钟" VerticalAlignment="Center"/><TextBox Width="60" Text="{Binding DurationMinutes}" Margin="4,0"/>
          </WrapPanel>
          <WrapPanel Margin="0,4,0,0">
            <TextBlock Text="目标类型" VerticalAlignment="Center"/><ComboBox Width="150" ItemsSource="{Binding AvailableTargetObservabilityClasses}" SelectedItem="{Binding TargetObservability}" Margin="4,0,9,0"/>
            <TextBlock Text="围墙" VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding HorizonMinimumDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="启动裕量" VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding HorizonStartMarginDegrees}" Margin="4,0,9,0"/>
            <TextBlock Text="继续裕量" VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding HorizonContinueMarginDegrees}" Margin="4,0"/>
          </WrapPanel>
        </StackPanel>
      </ninaSeq:HierarchicalSequenceContainerView.SequenceContainerContent>
    </ninaSeq:HierarchicalSequenceContainerView>
  </HierarchicalDataTemplate>

  <DataTemplate DataType="{x:Type seq:ObservationStageMarkerItem}">
    <ninaSeq:SequenceBlockView>
      <ninaSeq:SequenceBlockView.SequenceItemContent>
        <TextBlock Text="{Binding DisplayName}" FontStyle="Italic" Opacity="0.8" />
      </ninaSeq:SequenceBlockView.SequenceItemContent>
    </ninaSeq:SequenceBlockView>
  </DataTemplate>
</ResourceDictionary>
