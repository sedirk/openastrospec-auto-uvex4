<ResourceDictionary x:Class="UvexAdv.Nina.Plugin.Templates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UvexAdv.Nina.Plugin"
                    xmlns:seq="clr-namespace:UvexAdv.Nina.Plugin.SequenceItems"
                    xmlns:ninaSeq="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
                    xmlns:spec="clr-namespace:UvexAdv.Spectroscopy;assembly=UvexAdv.Spectroscopy">
  <DataTemplate x:Key="OpenAstroSpec Auto — UVEX4_Options">
    <Grid Margin="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="3" Padding="9" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="OpenAstroSpec Auto · ATR/UVEX4 光谱工具设置" FontWeight="Bold" FontSize="15" />
          <TextBlock Text="这里只配置自动观测界面中的 ATR 单帧检查，以及 Advanced Sequencer 中的 UVEX4 M2 谱线对焦和光栅波长锁定。它不配置 C11 主镜对焦、G3 导星镜对焦、目标入缝或自动科学曝光计划。"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <TabControl Grid.Row="1">
        <TabItem Header="范围与连接">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="设备所有权：N.I.N.A. 独占 ATR585M；UvexAdv.Service 独占 UVEX4 / COM5。此页不会让插件直接打开相机 SDK 或串口。"
                       TextWrapping="Wrap" Foreground="#7DD3FC" Margin="0,0,0,10" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="UVEX 服务 API 地址" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServiceUrl, UpdateSourceTrigger=PropertyChanged}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="ATR 型号名回退（仅影子检查）" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExpectedCameraName, UpdateSourceTrigger=PropertyChanged}" Margin="5,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="已绑定 ATR DeviceId" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BoundCameraId, Mode=OneWay}" IsReadOnly="True" Margin="5,2" />
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                       Text="DeviceId 由“OpenAstroSpec 自动观测 → 实时图像 → ATR 二维/一维光谱”或校准库中的显式“绑定当前 ATR585M”按钮写入。绑定后闭环必须精确匹配 DeviceId；型号名称不能绕过绑定。"
                       TextWrapping="Wrap" Foreground="#FBBF24" Margin="0,9,0,0" />
          </Grid>
        </TabItem>

        <TabItem Header="ATR 提取">
          <Grid Margin="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/><ColumnDefinition Width="85"/><ColumnDefinition Width="18"/>
              <ColumnDefinition Width="170"/><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="6"
                       Text="这些值只用于光谱工具的 ATR 单帧测量。所谓“提取矩形”是在 N.I.N.A. 完整图像上做的软件裁切，不会改写相机驱动的硬件 ROI。"
                       TextWrapping="Wrap" Foreground="#7DD3FC" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="测量曝光（秒）" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExposureSeconds}" Margin="5,2" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="增益（-1 表示不覆盖）" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Gain}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Offset}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Binning" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Binning}" Margin="5,2" />

            <TextBlock Grid.Row="3" Grid.ColumnSpan="6" Text="软件提取矩形（原始全帧像素）" FontWeight="Bold" Margin="0,9,0,3" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="左上角 X / Y（px）" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"><TextBox Width="70" Text="{Binding RoiX}" Margin="5,2"/><TextBox Width="70" Text="{Binding RoiY}" Margin="5,2"/></WrapPanel>
            <TextBlock Grid.Row="4" Grid.Column="3" Text="宽 / 高（px）" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2"><TextBox Width="70" Text="{Binding RoiWidth}" Margin="5,2"/><TextBox Width="70" Text="{Binding RoiHeight}" Margin="5,2"/></WrapPanel>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="交叉色散孔径起点 / 长度（px）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"><TextBox Width="70" Text="{Binding ApertureStart}" Margin="5,2"/><TextBox Width="70" Text="{Binding ApertureLength}" Margin="5,2"/></WrapPanel>
            <TextBlock Grid.Row="5" Grid.Column="3" Text="色散方向" VerticalAlignment="Center" />
            <ComboBox Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="2" Width="130" HorizontalAlignment="Left"
                      SelectedValue="{Binding DispersionAxis}" SelectedValuePath="Tag" Margin="5,2">
              <ComboBoxItem Content="水平色散（沿 X）" Tag="{x:Static spec:DispersionAxis.Horizontal}" />
              <ComboBoxItem Content="垂直色散（沿 Y）" Tag="{x:Static spec:DispersionAxis.Vertical}" />
            </ComboBox>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,2">
              <CheckBox Content="启用 ATR585M SDK 行回绕自动修复"
                        IsChecked="{Binding AutoRepairAtr585mSdkWrap}" HorizontalAlignment="Left" />
              <TextBlock Text="启用 ATR585M SDK 行回绕自动修复" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <WrapPanel Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="3" Margin="0,6,0,0">
              <TextBlock Text="位移（px）" VerticalAlignment="Center"/><TextBox Width="60" Text="{Binding SdkWrapShiftPixels}" Margin="5,2"/>
              <TextBlock Text="接缝门（σ）" VerticalAlignment="Center"/><TextBox Width="60" Text="{Binding SdkWrapSeamSigma}" Margin="5,2"/>
            </WrapPanel>
            <TextBlock Grid.Row="7" Grid.ColumnSpan="6"
                       Text="孔径起点是相对于上述软件提取矩形、沿交叉色散方向的偏移；它不是整幅图像坐标。"
                       TextWrapping="Wrap" Foreground="#FBBF24" Margin="0,7,0,0" />
          </Grid>
        </TabItem>

        <TabItem Header="M2 对焦">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="110"/><ColumnDefinition Width="22"/><ColumnDefinition Width="220"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="6"
                       Text="这里的“对焦”只指 UVEX 光谱仪内部 M2，通过多条谱线的 FWHM 做七点扫描。它与 C11 主镜、G3M2210M 导星模组小镜头和狭缝照明图像对焦无关。"
                       TextWrapping="Wrap" Foreground="#7DD3FC" Margin="0,0,0,9" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="本夜 M2 策略" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Width="320" SelectedValue="{Binding M2FocusMode, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Content="保持当前位置（默认，不移动 M2）" Tag="{x:Static local:M2FocusOperationMode.KeepCurrentPosition}" />
                <ComboBoxItem Content="已标定的七点谱线自动对焦（会移动 M2）" Tag="{x:Static local:M2FocusOperationMode.CommissionedSpectralAutofocus}" />
              </ComboBox>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="参考谱线位置（1D 光谱 px）" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding FocusLinePixelsCsv}" Margin="5,2" IsEnabled="{Binding SpectralAutofocusCommissioned}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="七点扫描步长（M2 电机步）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FocusStepSize}" Margin="5,2" IsEnabled="{Binding SpectralAutofocusCommissioned}" />
            <TextBlock Grid.Row="3" Grid.Column="3" Text="同向逼近预压量（M2 电机步）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding FocusBacklash}" Margin="5,2" IsEnabled="{Binding SpectralAutofocusCommissioned}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="允许的绝对最小位置（M2 步）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FocusMinimum}" Margin="5,2" IsEnabled="{Binding SpectralAutofocusCommissioned}" />
            <TextBlock Grid.Row="4" Grid.Column="3" Text="允许的绝对最大位置（M2 步）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding FocusMaximum}" Margin="5,2" IsEnabled="{Binding SpectralAutofocusCommissioned}" />
            <Border Grid.Row="5" Grid.ColumnSpan="6" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,10,0,0">
              <TextBlock Text="{Binding SpectralAutofocusStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="#FBBF24" />
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="光栅锁定">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="光栅闭环测量一条已知参考谱线，把它移动到指定的 1D 光谱像素。步/像素必须带正确正负方向；这不是名义波长输入，也不等同于自动观测已调试。"
                       TextWrapping="Wrap" Foreground="#7DD3FC" Margin="0,0,0,9" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
              <CheckBox Content="单独授权 UVEX 光栅波长锁定（会产生光栅机械运动）"
                        IsChecked="{Binding WavelengthLockCommissioned}" HorizontalAlignment="Left" />
              <TextBlock Text="单独授权 UVEX 光栅波长锁定（会产生光栅机械运动）"
                         VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FBBF24" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="参考谱线当前位置（1D 光谱 px）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WavelengthReferencePixelText}" Margin="5,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="参考谱线目标位置（1D 光谱 px）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WavelengthTargetPixelText}" Margin="5,2" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="光栅响应（带符号的电机步 / px）" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GratingStepsPerPixelText}" Margin="5,2" />
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.RowSpan="3"
                       Text="空白表示尚未配置。界面不再显示内部 NaN 哨兵值；任何字段缺失或响应为 0 时，闭环会在申请 UVEX 控制租约之前拒绝。"
                       TextWrapping="Wrap" Foreground="#FBBF24" Margin="15,3,0,0" />
            <Border Grid.Row="5" Grid.ColumnSpan="3" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,10,0,0">
              <TextBlock Text="{Binding WavelengthLockStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="#FBBF24" />
            </Border>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="UvexAdv.Nina.Plugin.ObservationDockable_Dockable">
    <Grid Margin="4" Background="#0B1220">
      <Grid.Resources>
        <BooleanToVisibilityConverter x:Key="ObservationBoolToVisibility" />
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="#E5E7EB" />
          <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
          <Setter Property="Foreground" Value="#F8FAFC" />
          <Setter Property="Background" Value="#155E75" />
          <Setter Property="BorderBrush" Value="#38BDF8" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Padding" Value="9,5" />
          <Setter Property="Margin" Value="2" />
          <Setter Property="MinHeight" Value="30" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="ObservationButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ObservationButtonBorder" Property="BorderBrush" Value="#BAE6FD" /></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="ObservationButtonBorder" Property="Opacity" Value="0.75" /></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ObservationButtonBorder" Property="BorderBrush" Value="#FDE047" /><Setter TargetName="ObservationButtonBorder" Property="BorderThickness" Value="2" /></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#64748B" /><Setter Property="Background" Value="#172033" /><Setter Property="BorderBrush" Value="#334155" /></Trigger>
          </Style.Triggers>
        </Style>
        <Style x:Key="ObservationModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Background" Value="#172033" />
          <Setter Property="BorderBrush" Value="#475569" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter Property="Background" Value="#0F766E" />
              <Setter Property="BorderBrush" Value="#5EEAD4" />
              <Setter Property="Foreground" Value="White" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Foreground" Value="#F8FAFC" />
          <Setter Property="Background" Value="#111827" />
          <Setter Property="BorderBrush" Value="#475569" />
          <Setter Property="CaretBrush" Value="#F8FAFC" />
          <Setter Property="Padding" Value="5,3" />
          <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Foreground" Value="#0F172A" />
          <Setter Property="Background" Value="#F8FAFC" />
          <Setter Property="BorderBrush" Value="#475569" />
          <Setter Property="Padding" Value="5,3" />
          <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="PreparationFieldBorder" TargetType="Border">
          <Setter Property="Background" Value="#0E2A1B" />
          <Setter Property="BorderBrush" Value="#22C55E" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="5" />
          <Setter Property="Padding" Value="9" />
          <Setter Property="Margin" Value="0,0,0,7" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
              <Setter Property="Background" Value="#3F1515" />
              <Setter Property="BorderBrush" Value="#EF4444" />
              <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5E7EB" /></Style>
        <Style TargetType="Expander"><Setter Property="Foreground" Value="#E5E7EB" /></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#E5E7EB" /></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="#0B1220" /><Setter Property="BorderBrush" Value="#334155" /></Style>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="#CBD5E1" />
          <Setter Property="Background" Value="#172033" />
          <Setter Property="BorderBrush" Value="#475569" />
          <Setter Property="Padding" Value="10,6" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="ObservationTabHeader"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3,3,0,0"
                        Padding="{TemplateBinding Padding}"
                        Margin="1,0,1,0">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="10" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#0F766E" />
                    <Setter Property="BorderBrush" Value="#5EEAD4" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#7DD3FC" /></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FDE047" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="ListBox">
          <Setter Property="Background" Value="#0F172A" />
          <Setter Property="Foreground" Value="#E5E7EB" />
          <Setter Property="BorderBrush" Value="#334155" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="#E5E7EB" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#164E63" /></Trigger>
          </Style.Triggers>
        </Style>
      </Grid.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Fixed operational header: these controls never scroll out of view. -->
      <Border Grid.Row="0" Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,5">
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="OpenAstroSpec Auto — UVEX4" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Border Background="#713F12" CornerRadius="10" Padding="8,3" Margin="0,1,8,1">
              <TextBlock Text="{Binding ModeText}" Foreground="#FDE68A" FontWeight="Bold" />
            </Border>
            <Border Background="#0E2A1B" CornerRadius="10" Padding="8,3" Margin="0,1">
              <TextBlock Text="{Binding StateText}" Foreground="#86EFAC" FontWeight="Bold" />
            </Border>
          </WrapPanel>
          <WrapPanel Margin="0,5,0,0">
            <TextBlock Text="当前：" FontWeight="Bold" Foreground="#7DD3FC" />
            <TextBlock Text="{Binding CurrentStageText}" Margin="0,0,14,0" />
            <TextBlock Text="下一步：" FontWeight="Bold" Foreground="#7DD3FC" />
            <TextBlock Text="{Binding NextStageText}" />
          </WrapPanel>
          <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,3,0,0" />
          <TextBlock Text="{Binding PauseReason, StringFormat=暂停原因：{0}}" Foreground="#FBBF24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"
                     Visibility="{Binding HasPauseReason, Converter={StaticResource ObservationBoolToVisibility}}" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="10" Margin="0,6,0,5" />
          <WrapPanel>
            <Button Style="{StaticResource ObservationModeButton}" Tag="{Binding IsSimulationMode}" Content="模拟自动观测" Command="{Binding SelectSimulationModeCommand}" ToolTip="只切换自动观测模式；不会连接或移动设备。" />
            <Button Style="{StaticResource ObservationModeButton}" Tag="{Binding IsRealMode}" Content="真实自动观测" Command="{Binding SelectRealModeCommand}" ToolTip="只选择自动观测执行方式；不是设备连接按钮。" />
            <Button Content="UVEX 设备手控" Command="{Binding ShowManualUvexControlCommand}" Background="#0F766E" BorderBrush="#5EEAD4" ToolTip="切缝、狭缝灯和 M2 小步进；不要求自动观测全套准入。" />
            <Button Content="{Binding StartButtonText}" Command="{Binding StartSelectedModeCommand}" Background="#166534" BorderBrush="#4ADE80" FontWeight="Bold" />
            <Button Content="暂停" Command="{Binding PauseCommand}" ToolTip="当前有界动作结束后阻止下一项动作或曝光。" />
            <Button Content="恢复并复核" Command="{Binding ResumeCommand}" ToolTip="恢复前重新检查全部可能过期的门。" />
            <Button Content="人工接管" Command="{Binding TakeoverCommand}" />
            <Button Content="清除旧 G3 状态" Command="{Binding ClearG3RecoveryStateCommand}"
                    Background="#92400E" BorderBrush="#FBBF24" FontWeight="Bold"
                    ToolTip="取消当前失败运行，接受人工接管后的当前状态并关闭过时的 G3 自动返回账本。不会移动赤道仪；原账本与审计记录会保留。清除后可直接重新启动。" />
            <Button Content="取消并安全收尾" Command="{Binding CancelCommand}" Background="#7F1D1D" BorderBrush="#FB7185" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- The main area uses tabs instead of one very long, nested-scroll page. -->
      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedWorkspaceTabIndex, Mode=TwoWay}">
        <TabItem Header="运行概览">
          <StackPanel Margin="9">
            <Border Background="#0E2A1B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="自动流程（真实成功路线）" FontWeight="Bold" Foreground="#86EFAC" />
                <TextBlock Text="目录转向 → QHY 广域见证 → G3 解算 / N.I.N.A. 大步修正 / 邻场搜索 → PHD2 入缝并导星 → ATR 自适应曝光 + QHY 同步测光"
                           Foreground="#D1FAE5" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <Border x:Name="RealModeStartupSummary" Background="#172033" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding RealModeStatusSummary}" Foreground="#FBBF24" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="自动观测准备与 UVEX 手控彼此独立；切缝和 M2 对焦不需要先填完自动观测表单。"
                             Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button Content="编辑观测计划" Command="{Binding ShowObservationPlanCommand}" />
                  <Button Content="填写自动准备表单" Command="{Binding ShowStartupRequirementsCommand}" />
                </WrapPanel>
              </Grid>
            </Border>
            <Border x:Name="OperationalReadinessSummary" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="PHD2 导星" FontWeight="Bold" Foreground="#FDE68A" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel Grid.Row="0" Grid.Column="1">
                  <TextBlock Text="{Binding Phd2CalibrationOverviewGradeText}" FontWeight="Bold" Foreground="#FDBA74" />
                  <TextBlock Text="{Binding Phd2CalibrationOverviewText}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Content="详细策略" Command="{Binding ShowStartupRequirementsCommand}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,7" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="目标定位辅助" FontWeight="Bold" Foreground="#7DD3FC" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                  <TextBlock Text="{Binding GhostAssistanceModeText}" FontWeight="Bold" Foreground="#7DD3FC" />
                  <TextBlock Text="{Binding GhostOverviewText}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="设备手控">
          <ScrollViewer x:Name="ManualUvexControlScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">
          <Grid Margin="9">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="UVEX4 手动准备" FontSize="15" FontWeight="Bold" Foreground="#7DD3FC" />
                  <TextBlock Text="用于观测前借天光选缝、开关狭缝灯和简单调整 M2。只经过 UvexAdv.Service → COM5；不要求本夜光学设置、PHD2、QHY、WCS 或完整自动观测标定。"
                             Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,3,10,0" />
                  <WrapPanel Margin="0,5,10,0">
                    <TextBlock Text="设备" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding ManualUvexDeviceChoices}"
                              SelectedItem="{Binding SelectedManualUvexDevice, Mode=TwoWay}"
                              Width="190"
                              ToolTip="选择保存在当前 N.I.N.A. Profile；本机安全配置只允许 UVEX4 / COM5，不扫描其他串口。" />
                    <TextBlock Text="已保存；打开本页不会连接"
                               Foreground="#86EFAC" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </WrapPanel>
                  <TextBlock Text="{Binding ManualUvexServiceUrl, StringFormat=控制服务：{0}}" Foreground="#94A3B8" Margin="0,3,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button Content="刷新状态" Command="{Binding RefreshManualUvexStatusCommand}" />
                  <Button Content="连接" Command="{Binding ConnectManualUvexCommand}" Background="#166534" BorderBrush="#4ADE80"
                          ToolTip="显式打开已保存的 UVEX4 / COM5 并读取可信位置。" />
                  <Button Content="断开" Command="{Binding DisconnectManualUvexCommand}"
                          ToolTip="关闭 COM5 并保持断开；服务不会在后台自动重连。" />
                  <Button Content="释放 COM5 给原厂软件" Command="{Binding ReleaseManualUvexComPortCommand}" Background="#7F1D1D" BorderBrush="#FB7185"
                          ToolTip="让服务进入维护模式并关闭 COM5；不会移动任何机构。再次点击连接 UVEX4 可恢复。" />
                </WrapPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding ManualUvexConnectionStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ManualUvexPositionStatus}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock Text="{Binding ManualUvexLastAction}" Foreground="#86EFAC" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" Padding="9">
                <StackPanel>
                  <TextBlock Text="切换狭缝" FontSize="14" FontWeight="Bold" />
                  <TextBlock Text="按钮按机械槽位编号；括号内是标称宽度。每次动作完成后必须回读到相同槽位。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,5" />
                  <WrapPanel>
                    <Button Content="1 · 300 µm" Command="{Binding SelectManualSlit1Command}" />
                    <Button Content="2 · 15 µm" Command="{Binding SelectManualSlit2Command}" />
                    <Button Content="3 · 25 µm" Command="{Binding SelectManualSlit3Command}" />
                    <Button Content="4 · 35 µm" Command="{Binding SelectManualSlit4Command}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" Padding="9">
                <StackPanel>
                  <TextBlock Text="M2 简单对焦" FontSize="14" FontWeight="Bold" />
                  <TextBlock Text="只做相对小步进；绝对行程和单次最大步数仍由 UVEX 服务限位。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,5" />
                  <WrapPanel>
                    <TextBlock Text="每次" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ManualM2StepSize, UpdateSourceTrigger=PropertyChanged}" Width="75" Margin="5,2" />
                    <TextBlock Text="步" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <Button Content="{Binding ManualM2NegativeButtonText}" Command="{Binding MoveManualM2NegativeCommand}" />
                    <Button Content="{Binding ManualM2PositiveButtonText}" Command="{Binding MoveManualM2PositiveCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="3" Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
              <WrapPanel>
                <TextBlock Text="狭缝照明灯" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="打开照明灯" Command="{Binding ManualSlitLightOnCommand}" />
                <Button Content="关闭照明灯" Command="{Binding ManualSlitLightOffCommand}" Background="#7F1D1D" BorderBrush="#FB7185" />
                <TextBlock Text="灯状态是服务命令完成回读；UVEX 串口协议不提供独立电气遥测。" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0" />
              </WrapPanel>
            </Border>

            <Border Grid.Row="4" Background="#3F1515" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="5" Padding="8"
                    Visibility="{Binding HasManualUvexError, Converter={StaticResource ObservationBoolToVisibility}}">
              <TextBlock Text="{Binding ManualUvexError}" Foreground="#FCA5A5" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="观测计划">
          <ScrollViewer x:Name="ObservationPlanScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">
          <Grid Margin="9">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="目标导入" FontSize="15" FontWeight="Bold" />
                <TextBlock Text="从 N.I.N.A. 构图或第三方星图读取目标草稿；只更新目标字段，不连接设备或启动观测。"
                           Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,3,0,5" />
                <WrapPanel>
                  <Button x:Name="ImportFramingAssistantButton"
                          Content="从构图助手当前构图导入"
                          Command="{Binding ImportFromFramingAssistantCommand}"
                          AutomationProperties.Name="从构图助手当前构图导入"
                          ToolTip="读取本次构图矩形的初始中心或当前构图中心并换算为 J2000 坐标；不会操作设备。" />
                  <Button Content="从第三方星图当前选择导入"
                          Command="{Binding ImportFromPlanetariumCommand}"
                          AutomationProperties.Name="从第三方星图当前选择导入"
                          ToolTip="通过 N.I.N.A. 当前第三方星图设置读取已选目标；不会操作设备。" />
                  <CheckBox IsChecked="{Binding ImportFramingCenter, Mode=TwoWay}"
                            IsEnabled="{Binding ElementName=ImportFramingAssistantButton, Path=IsEnabled}"
                            Content="使用当前构图中心"
                            Margin="9,5,2,0"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="使用构图中心"
                            ToolTip="默认关闭并使用构图矩形的初始中心；打开后使用当前画面中心。" />
                </WrapPanel>
                <Border Background="#132238" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="7" Margin="2,5,2,0"
                        Visibility="{Binding IsTargetImportBusy, Converter={StaticResource ObservationBoolToVisibility}}">
                  <TextBlock Text="正在读取目标并换算 J2000 坐标……" Foreground="#7DD3FC" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <Border Background="#0E2A1B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="7" Margin="2,5,2,0"
                        Visibility="{Binding HasTargetImport, Converter={StaticResource ObservationBoolToVisibility}}">
                  <StackPanel>
                    <TextBlock Text="{Binding TargetImportSummary}" Foreground="#86EFAC" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TargetImportDetails}" Foreground="#D1FAE5" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                  <TextBlock Text="目标名称" FontWeight="SemiBold" />
                  <TextBox Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTargetPlanEditable}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                  <TextBlock Text="目录 ID" FontWeight="SemiBold" />
                  <TextBox Text="{Binding CatalogId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTargetPlanEditable}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                  <TextBlock Text="赤经 RA（J2000，度）" FontWeight="SemiBold" />
                  <TextBox Text="{Binding RightAscensionDegrees, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTargetPlanEditable}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                  <TextBlock Text="赤纬 Dec（J2000，度）" FontWeight="SemiBold" />
                  <TextBox Text="{Binding DeclinationDegrees, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTargetPlanEditable}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="本夜光学设置 ID" FontWeight="SemiBold" />
                  <TextBox Text="{Binding NightSetupId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                  <TextBlock Text="并行观测与初始地平线规划时长（分钟）" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,2,0,0"
                           ToolTip="用于并行 QHY 任务长度及自动观测开始时的地平线保护估算；不是 ATR 单帧曝光的硬超时。" />
                  <TextBlock Text="不是曝光倒计时：已开始的 ATR 曝光会完整结束；ATR 科学帧张数由高级设置控制。600 s 单帧不会在这里填 10 分钟时被中途截断。"
                             Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,7,0,0">
                  <TextBlock Text="目标在 G3 中的可观测类型" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding AvailableTargetObservabilityClasses}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding TargetObservability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsTargetPlanEditable}"
                            Margin="0,2,0,0" />
                  <TextBlock Text="{Binding TargetObservabilitySummary}" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Grid.Row="2"
                       Text="导入不会改变本夜光学设置、设备标定、安全限制、运行模式或已创建的高级序列；入缝前仍需复核目录身份与 J2000 坐标。站点、地平线和模拟速度已移到“高级设置”。"
                       Foreground="#FDE68A" TextWrapping="Wrap" Margin="3,7,3,0" />
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="自动准备">
          <ScrollViewer x:Name="AutomaticPreparationScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        PanningMode="VerticalOnly">
          <Grid Margin="9">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Text="真实自动观测准备表" FontSize="15" FontWeight="Bold" Foreground="#7DD3FC" />
                  <TextBlock Text="启动时自动恢复上次台站方案；设备候选来自 N.I.N.A.、PHD2 和 QHY 服务各自保存的配置。列出候选不会连接设备，红框只表示真正缺少的资料。"
                             Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding AutomaticPreparationSummary}" Foreground="#FDE68A" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="重新扫描保存的配置" Command="{Binding RefreshCommissioningProfilesCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="台站配置方案" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <ComboBox ItemsSource="{Binding CommissioningProfiles}"
                            SelectedItem="{Binding SelectedCommissioningProfile, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName" MinWidth="360" HorizontalAlignment="Stretch" />
                  <TextBlock Text="{Binding SelectedCommissioningProfileDescription}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding CommissioningProfileLoadStatus}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <TextBlock Text="启动时默认选择最新完整标定包；哈希、内部引用和设备身份的静态校验全部通过后自动确认。此过程不连接或移动设备。"
                             Foreground="#7DD3FC" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="加载所选方案" Command="{Binding ApplySelectedCommissioningProfileCommand}" Margin="10,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PreparationFieldBorder}" Tag="{Binding IsTargetPreparationMissing}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="1. 观测目标" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding TargetPreparationStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="选择/导入目标" Command="{Binding ShowObservationPlanCommand}" Margin="10,0,0,0" />
              </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource PreparationFieldBorder}" Tag="{Binding IsDevicePreparationMissing}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="2. 设备身份" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,8,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding DevicePreparationStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="赤道仪（N.I.N.A.）" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TelescopeCandidates}" SelectedItem="{Binding SelectedTelescopeCandidate, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="4,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="光谱相机 ATR" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AtrCameraCandidates}" SelectedItem="{Binding SelectedAtrCameraCandidate, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="4,2" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="导星相机 G3 / PHD2" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding G3CameraCandidates}" SelectedItem="{Binding SelectedG3CameraCandidate, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="4,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="测光相机 QHY" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding QhyCameraCandidates}" SelectedItem="{Binding SelectedQhyCameraCandidate, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="4,2" />
                  </Grid>
                  <TextBlock Text="这里只选择期望身份：ATR 仍归 N.I.N.A.，G3 仍归 PHD2，QHY 仍归独立 QHY 服务。无需把三台相机轮流接进 N.I.N.A.。"
                             Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource PreparationFieldBorder}" Tag="{Binding IsCommissioningPreparationMissing}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="3. 一次性安装标定" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,8,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding CommissioningPreparationStatus}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PreparationEvidenceInventorySummary}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="这里不是普通表单：ID、SHA-256、四槽狭缝指纹、三焦域身份和运动限额必须由标定流程整体生成或导入，界面不会让你手抄。"
                             Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="导入完整标定包" Command="{Binding ImportCommissioningBindingsCommand}" Margin="10,0,0,0" VerticalAlignment="Top" />
              </Grid>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource PreparationFieldBorder}" Tag="{Binding IsNightSetupPreparationMissing}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="4. 本次观测配置" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,8,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding NightSetupPreparationStatus}" TextWrapping="Wrap" />
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="目标波段" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PreparationSpectralRegionChoices}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedPreparationSpectralRegion, Mode=TwoWay}" Margin="4,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="波长标定参考" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PreparationCalibrationReferenceChoices}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedPreparationCalibrationReference, Mode=TwoWay}" Margin="4,2" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="安全能力" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PreparationSafetyCapabilityChoices}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedPreparationSafetyCapability, Mode=TwoWay}" Margin="4,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="长波二级谱抑制" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="3" Grid.Column="1" Content="已安装并经过确认的级次分选滤镜"
                              IsChecked="{Binding PreparationOrderSortingFilterInstalled, Mode=TwoWay}" Margin="4,4" />
                  </Grid>
                  <TextBlock Text="{Binding PreparationDraftStatus}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,5,0,0" />
                  <WrapPanel Margin="0,6,0,0">
                    <Button Content="自动生成准备草稿" Command="{Binding CreateNightSetupDraftCommand}" Margin="0,0,8,0" />
                    <Button Content="导入锁定本夜配置" Command="{Binding SelectNightSetupSnapshotCommand}" Margin="0,0,8,0" />
                    <Button Content="打开草稿位置" Command="{Binding OpenPreparationDraftFolderCommand}" />
                  </WrapPanel>
                  <TextBlock Text="草稿会自动汇总保存的身份、相机参数、狭缝和上述选择，但不会连接设备，也不会把尚未实测的焦点、光栅或运动证据伪装成已完成。"
                             Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource PreparationFieldBorder}" Tag="{Binding IsSlitChoiceMissing}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="5. 目标狭缝" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="由操作员选择；如果导入了本夜光学设置，会自动选中其中记录的槽位。" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" Width="190" Margin="10,0,0,0"
                          ItemsSource="{Binding UvexSlitChoices}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Position"
                          SelectedValue="{Binding ExpectedUvexSlitPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Border>

            <Border Grid.Row="7" Style="{StaticResource PreparationFieldBorder}" Tag="{Binding IsAutomationPolicyPreparationMissing}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="6. 自动检查结果" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding AutomationPolicyPreparationStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="查看工程诊断" Command="{Binding ShowAdvancedSettingsCommand}" Margin="10,0,0,0" />
              </Grid>
            </Border>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="实时图像">
          <TabControl Margin="6">
            <TabItem Header="QHY 广域 / 解算">
              <Grid Margin="7">
                <local:EmbeddedImageViewer PreviewImage="{Binding QhyPreviewImage}"
                                           Caption="{Binding QhyPreviewCaption}"
                                           EmptyTitle="尚无 QHY 广域图像"
                                           EmptyDetails="尚未收到 QHY/GS350 取景帧。请查看固定运行状态、QHY 当前阶段和最近质量门；选择模式本身不会连接相机。"
                                           PopoutCommand="{Binding OpenQhyPreviewCommand}"
                                           PopoutLabel="弹出 QHY 大图"
                                           ShowPopoutButton="True"
                                           MinHeight="220" />
              </Grid>
            </TabItem>
            <TabItem Header="G3 对焦 / 狭缝 / 导星">
              <Grid Margin="7">
                <local:EmbeddedImageViewer PreviewImage="{Binding G3PreviewImage}"
                                           Caption="{Binding G3PreviewCaption}"
                                           EmptyTitle="尚无 G3 狭缝场图像"
                                           EmptyDetails="尚未收到 PHD2/G3 全帧。请检查当前阶段和最近质量门；G3 仍只由 PHD2 持有。"
                                           PopoutCommand="{Binding OpenG3PreviewCommand}"
                                           PopoutLabel="弹出 G3 大图"
                                           ShowPopoutButton="True"
                                           MinHeight="220" />
              </Grid>
            </TabItem>
            <TabItem Header="ATR 二维 / 一维光谱">
              <Grid Margin="7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <local:EmbeddedImageViewer PreviewImage="{Binding AtrPreviewImage}"
                                             Caption="{Binding AtrPreviewCaption}"
                                             EmptyTitle="尚无自动观测 ATR 图像"
                                             EmptyDetails="自动流程尚未收到 N.I.N.A./ATR585M 探测或科学帧。右侧单帧检查不会启动整套自动观测。"
                                             PopoutCommand="{Binding OpenAtrPreviewCommand}"
                                             PopoutLabel="弹出 ATR 大图"
                                             ShowPopoutButton="True"
                                             MinHeight="220" />
                </Grid>
                <Border Grid.Column="2" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="9">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                      <TextBlock Text="ATR 单帧检查" FontWeight="Bold" FontSize="14" />
                      <TextBlock Text="用于绑定相机和检查提取结果；不会启动入缝、导星、UVEX 运动或自动科学序列。"
                                 TextWrapping="Wrap" Opacity="0.78" Margin="0,2,0,6" />
                      <TextBlock Text="{Binding AtrManualCameraStatus}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding BoundAtrCameraId, StringFormat=绑定 DeviceId：{0}}" TextWrapping="Wrap" Opacity="0.72" />
                      <TextBlock Text="{Binding AtrManualCapturePresetText, StringFormat=单帧设置：{0}}" TextWrapping="Wrap" Opacity="0.72" />
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,6,0,4">
                      <Button Content="绑定当前 ATR585M" Command="{Binding BindCurrentAtrCameraCommand}" />
                      <Button Content="刷新相机状态" Command="{Binding RefreshAtrManualStatusCommand}" />
                      <Button Content="采集一帧检查光谱" Command="{Binding CaptureManualAtrSpectrumCommand}" Background="#166534" BorderBrush="#22C55E" />
                    </WrapPanel>
                    <TextBlock Grid.Row="2" Text="{Binding AtrManualCaptureStatus}" TextWrapping="Wrap" Margin="0,2,0,5" />
                    <Border Grid.Row="3" BorderBrush="#475569" BorderThickness="1" MinHeight="150" Background="#08111F">
                      <Viewbox Stretch="Fill">
                        <Canvas Width="1" Height="1">
                          <Polyline Points="{Binding ManualSpectrumPoints}" Stroke="#38BDF8" StrokeThickness="0.005" />
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <TextBlock Grid.Row="4" Text="{Binding ManualSpectrumSummary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <Border Grid.Row="5" Background="#3F1515" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,5,0,0"
                            Visibility="{Binding HasAtrManualCaptureError, Converter={StaticResource ObservationBoolToVisibility}}">
                      <TextBlock Text="{Binding AtrManualCaptureError}" Foreground="#FCA5A5" TextWrapping="Wrap" />
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </TabItem>
          </TabControl>
        </TabItem>

        <TabItem Header="失败诊断">
          <Grid Margin="9">
            <Border Background="#0E2A1B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="14"
                    VerticalAlignment="Top" Visibility="{Binding HasNoFailure, Converter={StaticResource ObservationBoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="✓ 当前没有失败或待处理质量门" Foreground="#86EFAC" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="运行中若质量门失败或不确定，本页会显示预期/实测指标、对应图像和不可变证据。" Foreground="#A7F3D0" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Top"
                          Visibility="{Binding HasFailure, Converter={StaticResource ObservationBoolToVisibility}}">
              <Border Background="#321717" BorderBrush="#FB7185" BorderThickness="1" CornerRadius="6" Padding="13" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="{Binding LastFailureHeadline}" Foreground="#FDA4AF" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding LastFailureCode, StringFormat=错误代码：{0}}" FontFamily="Consolas" Foreground="#FDE68A" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding LastFailureMessage}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding LastFailureMetrics, StringFormat=质量数值：{0}}" FontFamily="Consolas" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Text="{Binding LastFailureRecommendation, StringFormat=建议：{0}}" Foreground="#FED7AA" TextWrapping="Wrap" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding LastFailureEvidencePath, StringFormat=失败证据：{0}}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="{Binding HasFailureEvidence, Converter={StaticResource ObservationBoolToVisibility}}" />
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="{Binding LastFailurePreviewLabel}" Command="{Binding OpenFailurePreviewCommand}" Visibility="{Binding HasFailurePreview, Converter={StaticResource ObservationBoolToVisibility}}" />
                    <Button Content="打开失败证据目录" Command="{Binding OpenFailureEvidenceDirectoryCommand}" Visibility="{Binding HasFailureEvidence, Converter={StaticResource ObservationBoolToVisibility}}" />
                    <Button Content="打开最近证据目录" Command="{Binding OpenLatestEvidenceDirectoryCommand}" Visibility="{Binding HasLatestEvidence, Converter={StaticResource ObservationBoolToVisibility}}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding LatestEvidenceSummary, StringFormat=最近证据：{0}}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem Header="质量门与证据">
          <TabControl Margin="6">
            <TabItem Header="质量门">
              <ListBox ItemsSource="{Binding GateRows}">
                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,6">
                  <StackPanel>
                    <WrapPanel><TextBlock Text="{Binding Stage}" FontWeight="Bold"/><TextBlock Text="{Binding State, StringFormat=  ·  {0}}" Foreground="#FBBF24" FontWeight="Bold"/></WrapPanel>
                    <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource ObservationBoolToVisibility}}">
                      <TextBlock Text="{Binding Code, StringFormat=代码：{0}}" FontFamily="Consolas" Foreground="#CBD5E1" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Message}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Metrics, StringFormat=数值：{0}}" Foreground="#94A3B8" FontFamily="Consolas" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="时间线">
              <ListBox ItemsSource="{Binding TimelineRows}">
                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,6">
                  <StackPanel>
                    <WrapPanel><TextBlock Text="{Binding Time}" Foreground="#94A3B8"/><TextBlock Text="{Binding Stage, StringFormat=  ·  {0}}" FontWeight="Bold"/></WrapPanel>
                    <TextBlock Text="{Binding Code, StringFormat=代码：{0}}" FontFamily="Consolas" Foreground="#CBD5E1" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EvidencePath, StringFormat=证据：{0}}" Foreground="#94A3B8" TextWrapping="Wrap"
                               Visibility="{Binding HasEvidence, Converter={StaticResource ObservationBoolToVisibility}}" />
                  </StackPanel>
                </Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="证据文件">
              <ListBox ItemsSource="{Binding EvidenceRows}">
                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,6">
                  <StackPanel>
                    <WrapPanel><TextBlock Text="{Binding Time}" Foreground="#94A3B8"/><TextBlock Text="{Binding Kind, StringFormat=  ·  {0}}" FontWeight="Bold"/></WrapPanel>
                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AbsolutePath}" Foreground="#94A3B8" TextWrapping="Wrap" />
                  </StackPanel>
                </Border></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
          </TabControl>
        </TabItem>

        <TabItem Header="高级设置">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
              <Border x:Name="RealModeStartupDetails" Background="#172033" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="真实模式启动条件" FontSize="15" FontWeight="Bold" Foreground="#FDE68A" />
                  <TextBlock Text="{Binding ModeDescription}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding RealModeStatus}" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <WrapPanel Margin="0,7,0,0">
                    <Button Content="导入设备标定方案" Command="{Binding ImportCommissioningBindingsCommand}" Margin="0,0,8,0" />
                    <Button Content="启用并核验恒星时跟踪" Command="{Binding EnableMountTrackingCommand}" AutomationProperties.AutomationId="OpenAstroSpec.EnableMountTracking" />
                  </WrapPanel>
                  <TextBlock Text="{Binding MountTrackingManualStatus}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="N.I.N.A. 原生目标归档" FontSize="15" FontWeight="Bold" Foreground="#7DD3FC" />
                  <TextBlock Text="ATR585M 仍由 N.I.N.A. 保存。模板必须包含目标名；推荐值还会按夜晚、目标和官方图像类型分目录。插件不会在启动时静默修改 Profile。"
                             Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,4,0,6" />
                  <TextBlock Text="当前 Profile 模板" FontWeight="SemiBold" />
                  <TextBox Text="{Binding NinaImageFilePatternCurrent, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,6" />
                  <TextBlock Text="OpenAstroSpec 推荐模板" FontWeight="SemiBold" />
                  <TextBox Text="{Binding NinaImageFilePatternRecommended, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,6" />
                  <TextBlock Text="{Binding NinaImageFilePatternStatus}" Foreground="#FDE68A" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,7,0,0">
                    <Button Content="应用推荐的目标分目录模板"
                            Command="{Binding ApplyRecommendedImageFilePatternCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="OpenAstroSpec.ApplyImageFilePattern" />
                    <Button Content="撤销本次模板修改"
                            Command="{Binding RestorePreviousImageFilePatternCommand}"
                            AutomationProperties.AutomationId="OpenAstroSpec.RestoreImageFilePattern" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Expander Header="PHD2 与目标定位策略详情" Margin="0,0,0,8">
                <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,4,0,0">
                  <StackPanel>
                    <WrapPanel>
                      <TextBlock Text="PHD2 校准质量" FontWeight="Bold" Foreground="#FDE68A" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Phd2CalibrationGradeText}" FontWeight="Bold" Foreground="#FDBA74" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Phd2CalibrationPolicyText, StringFormat=策略：{0}}" Foreground="#94A3B8" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Phd2CalibrationPermissionText}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Phd2CommissioningRouteText}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Phd2CalibrationScaleText}" Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Phd2CalibrationReasonText}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Separator Margin="0,8,0,7" />
                    <TextBlock Text="确定性鬼影辅助" FontWeight="Bold" Foreground="#7DD3FC" />
                    <TextBlock Text="仅提供辅助质心与协方差，不授予目标身份或运动权限。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding GhostCalibrationSummaryText}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding GhostApplicabilityText}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding GhostDecisionText}" Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
              </Expander>
              <Expander Header="ATR 长曝光期间的 QHY 并行成像" Margin="0,0,0,8">
                <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,4,0,0">
                  <StackPanel>
                    <TextBlock Text="滤镜循环（Filter:秒，逗号分隔）" FontWeight="Bold" Foreground="#7DD3FC" />
                    <TextBox Text="{Binding QhyParallelFilterSequenceCsv, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="留空沿用单滤镜测光；行星状星云示例：H:60,O:60,S:60"
                             Margin="0,4,0,0" />
                    <TextBlock Text="{Binding QhyParallelFilterSequenceStatus}" Foreground="#BAE6FD" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="最少星数" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding QhyMinimumDetectedStars}" Margin="5,0" ToolTip="0 = 仅记录，不阻断"/>
                      <TextBlock Grid.Column="3" Text="最低透明度" VerticalAlignment="Center"/><TextBox Grid.Column="4" Text="{Binding QhyMinimumTransparency}" Margin="5,0" ToolTip="0 = 仅记录，不阻断"/>
                      <TextBlock Grid.Column="6" Text="最大饱和比例" VerticalAlignment="Center"/><TextBox Grid.Column="7" Text="{Binding QhyMaximumSaturatedFraction}" Margin="5,0"/>
                    </Grid>
                    <TextBlock Text="它与 ATR 光谱曝光并行，不借用 ATR 或 G3 相机；若 QHY 支路被设为严格质量门，失败仍会暂停主流程。"
                               Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                </Border>
              </Expander>
              <Expander Header="站点、40° 围墙与模拟速度" Margin="0,0,0,8">
                <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"><TextBlock Text="站点纬度（度）"/><TextBox Text="{Binding SiteLatitudeDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,5"><TextBlock Text="站点东经（度）"/><TextBox Text="{Binding SiteLongitudeDegreesEast, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,5"><TextBlock Text="海拔（米）"/><TextBox Text="{Binding SiteElevationMeters, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,5"><TextBlock Text="围墙最低高度角（度）"/><TextBox Text="{Binding HorizonMinimumDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,5"><TextBlock Text="启动裕量（度）"/><TextBox Text="{Binding HorizonStartMarginDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,5"><TextBlock Text="继续运行裕量（度）"/><TextBox Text="{Binding HorizonContinueMarginDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"><TextBlock Text="模拟时每阶段停留时间（毫秒）"/><TextBox Text="{Binding SimulationStageMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/></StackPanel>
                  </Grid>
                </Border>
              </Expander>
              <Border Background="#10243B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                <StackPanel>
