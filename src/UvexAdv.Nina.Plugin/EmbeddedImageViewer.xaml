<UserControl x:Class="UvexAdv.Nina.Plugin.EmbeddedImageViewer"
             x:Name="ViewerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UvexAdv.Nina.Plugin"
             Background="#070D16"
             Foreground="#E5E7EB"
             Focusable="True"
             SnapsToDevicePixels="True"
             local:ObservationStaticTextLocalization.IsEnabled="True">
  <UserControl.Resources>
    <Style x:Key="ViewerToolbarButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F1F5F9" />
      <Setter Property="Background" Value="#172334" />
      <Setter Property="BorderBrush" Value="#52647A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#24364D" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38BDF8" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#0F766E" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ViewerToolbarToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="Background" Value="#172334" />
      <Setter Property="BorderBrush" Value="#52647A" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#7DD3FC" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleBorder" Property="Background" Value="#24364D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ViewerLevelSlider" TargetType="Slider">
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TickPlacement" Value="None" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Margin="4,0">
              <Border Height="3" Background="#475569" CornerRadius="1.5" VerticalAlignment="Center" />
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="9" Height="14" Background="#7DD3FC">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" /></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="#070D16" BorderBrush="#334155" BorderThickness="1" CornerRadius="5">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#101A28" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="4">
        <Grid ToolTip="滚轮缩放 · 左键拖动 · 双击适配">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="{Binding PopoutLabel, ElementName=ViewerRoot}"
                    Command="{Binding PopoutCommand, ElementName=ViewerRoot}"
                    ToolTip="在独立可缩放窗口中打开当前图像"
                    AutomationProperties.Name="弹出当前大图">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ViewerToolbarButton}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasImage, ElementName=ViewerRoot}" Value="True" />
                        <Condition Binding="{Binding ShowPopoutButton, ElementName=ViewerRoot}" Value="True" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Style="{StaticResource ViewerToolbarButton}"
                    Content="−"
                    ToolTip="缩小"
                    AutomationProperties.Name="缩小图像"
                    IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                    Click="OnZoomOutClick" />
            <TextBlock x:Name="ZoomTextBlock"
                       Width="50"
                       Text="100%"
                       FontFamily="Consolas"
                       FontWeight="SemiBold"
                       Foreground="#BAE6FD"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="当前缩放比例" />
            <Button Style="{StaticResource ViewerToolbarButton}"
                    Content="+"
                    ToolTip="放大"
                    AutomationProperties.Name="放大图像"
                    IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                    Click="OnZoomInClick" />
            <Button Style="{StaticResource ViewerToolbarButton}"
                    Content="适配"
                    ToolTip="完整图像适配当前视口；也可在图像上双击"
                    AutomationProperties.Name="使完整图像适配窗口"
                    IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                    Click="OnFitClick" />
            <Button Style="{StaticResource ViewerToolbarButton}"
                    Content="1:1"
                    ToolTip="一个源图像像素对应一个视图单位"
                    AutomationProperties.Name="按一比一显示图像"
                    IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                    Click="OnActualSizeClick" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="AutoStretchButton"
                  Style="{StaticResource ViewerToolbarButton}"
                  Content="自动拉伸：关"
                  ToolTip="按当前预览直方图自动设置显示黑白点；只影响屏幕显示，不修改 FITS、解算或质量数据"
                  AutomationProperties.Name="切换自动拉伸"
                  IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                  Click="OnAutoStretchClick" />
          <Button Style="{StaticResource ViewerToolbarButton}"
                  Content="原图"
                  ToolTip="恢复 N.I.N.A. 或采集服务提供的原始预览显示"
                  AutomationProperties.Name="恢复原始预览显示"
                  IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                  Click="OnResetDisplayClick" />
          <ToggleButton x:Name="DisplayLevelsToggle" Style="{StaticResource ViewerToolbarToggle}" Content="显示调节"
                        ToolTip="展开黑点、白点与 γ；仅影响二维图像显示" AutomationProperties.Name="展开图像显示调节" />
          <ToggleButton x:Name="SpectralRegionToggle" Style="{StaticResource ViewerToolbarToggle}" Content="谱带"
                        Visibility="Collapsed" IsChecked="True" Click="OnSpectralRegionClick"
                        ToolTip="切换谱带与全幅适配；不裁剪 FITS，不改变测量" />
          </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Padding="4,7,4,2">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=DisplayLevelsToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="黑" Margin="2,0" VerticalAlignment="Center" Foreground="#CBD5E1" />
          <Slider Grid.Column="1" x:Name="BlackPointSlider" Style="{StaticResource ViewerLevelSlider}" Minimum="0" Maximum="254" Value="0"
                  IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                  ValueChanged="OnManualDisplayValueChanged" />
          <TextBlock Grid.Column="2" x:Name="BlackPointText" Text="0" Width="30" Margin="3,0,6,0"
                     FontFamily="Consolas" VerticalAlignment="Center" Foreground="#BAE6FD" />
          <TextBlock Grid.Column="3" Text="白" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="#CBD5E1" />
          <Slider Grid.Column="4" x:Name="WhitePointSlider" Style="{StaticResource ViewerLevelSlider}" Minimum="1" Maximum="255" Value="255"
                  IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                  ValueChanged="OnManualDisplayValueChanged" />
          <TextBlock Grid.Column="5" x:Name="WhitePointText" Text="255" Width="34" Margin="3,0,6,0"
                     FontFamily="Consolas" VerticalAlignment="Center" Foreground="#BAE6FD" />
          <TextBlock Grid.Column="6" Text="γ" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="#CBD5E1" />
          <Slider Grid.Column="7" x:Name="GammaSlider" Style="{StaticResource ViewerLevelSlider}" Minimum="0.2" Maximum="5" Value="1"
                  TickFrequency="0.1"
                  IsEnabled="{Binding HasImage, ElementName=ViewerRoot}"
                  ValueChanged="OnManualDisplayValueChanged" />
          <TextBlock Grid.Column="8" x:Name="GammaText" Text="1.00" Width="42" Margin="3,0,2,0"
                     FontFamily="Consolas" VerticalAlignment="Center" Foreground="#BAE6FD" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="9" x:Name="DisplayLevelsText" Text="显示：原图" Margin="0,3,0,0"
                     VerticalAlignment="Center" Foreground="#94A3B8" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Background="#02060C">
        <ScrollViewer x:Name="ViewportScrollViewer"
                      Background="#02060C"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      CanContentScroll="False"
                      PanningMode="None"
                      PreviewMouseWheel="OnPreviewMouseWheel"
                      PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                      PreviewMouseMove="OnPreviewMouseMove"
                      LostMouseCapture="OnLostMouseCapture"
                      SizeChanged="OnViewportSizeChanged">
          <Grid x:Name="ImageSurface" ClipToBounds="True">
            <Grid.LayoutTransform>
              <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>
            <Image x:Name="PreviewImageElement" Stretch="Fill" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="AnnotationImageElement" Stretch="Fill" IsHitTestVisible="False" />
          </Grid>
        </ScrollViewer>

        <Border x:Name="EmptyStatePanel"
                Margin="18"
                Padding="18"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#0B1422"
                BorderBrush="#475569"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False">
          <StackPanel>
            <TextBlock Text="○"
                       FontSize="28"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyTitle, ElementName=ViewerRoot}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#E2E8F0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding EmptyDetails, ElementName=ViewerRoot}"
                       Foreground="#94A3B8"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="SpectrumPanel" Grid.Row="2" Visibility="Collapsed"
              Background="#081322" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="7,5">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="SpectrumOrientationNote" DockPanel.Dock="Right" Foreground="#94A3B8" Margin="10,0,0,0" />
            <TextBlock x:Name="SpectrumTitle" Foreground="#7DD3FC" TextWrapping="Wrap"
                       ToolTip="空间方向抽样平均，仅诊断；图像拉伸不改变曲线。蓝端和红端以 Night Setup 为准。" />
          </DockPanel>
          <Image x:Name="SpectrumImageElement" Height="90" Margin="0,4,0,0" Stretch="Fill" />
        </StackPanel>
      </Border>

      <Border x:Name="CaptionPanel"
              Grid.Row="3"
              Background="#0C1522"
              BorderBrush="#334155"
              BorderThickness="0,1,0,0"
              Padding="6,3">
        <TextBlock Text="{Binding Caption, ElementName=ViewerRoot}"
                   Foreground="#CBD5E1"
                   TextWrapping="Wrap" />
      </Border>
    </Grid>
  </Border>
</UserControl>
