# Raw astronomy/camera data are observation assets, not source code. Small,
# deliberately curated regression fixtures may be force-added under a fixture
# directory when their provenance and license are documented.
*.fit
*.fits
*.fts
*.ser
*.xisf
*.raw
!tests/fixtures/**/*.fit
!tests/fixtures/**/*.fits
!reduction/tests/fixtures/**/*.fit
!reduction/tests/fixtures/**/*.fits
